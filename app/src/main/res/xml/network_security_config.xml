<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      Il server Vigilo si raggiunge sempre in HTTPS (Tailscale, certificato pubblico): l'app rifiuta
      gli abbinamenti non HTTPS. Il traffico in chiaro resta consentito solo per compatibilità.
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>

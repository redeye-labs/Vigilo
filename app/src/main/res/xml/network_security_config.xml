<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      Il server Vigilo si raggiunge sempre in HTTPS (Tailscale, certificato pubblico): l'app rifiuta
      gli abbinamenti non HTTPS. I collegamenti HTTP non cifrati sono vietati.
    -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>

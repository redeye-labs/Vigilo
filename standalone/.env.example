# Copia questo file in ".env" (cp .env.example .env) e modifica solo quello che ti serve.
# Tutte le voci sono facoltative.

# Nome del nodo Tailscale: diventa https://<nome>.<tuo-tailnet>.ts.net
# Se hai già Vigilo su Home Assistant nello stesso tailnet, usa un nome diverso (es. vigilo-docker).
VIGILO_TS_HOSTNAME=vigilo

# Chiave di autenticazione Tailscale (tskey-auth-...). Se la lasci vuota, la pagina di Vigilo
# mostra il pulsante «Accedi a Tailscale» come nel componente aggiuntivo.
TS_AUTHKEY=

# Password della pagina di Vigilo (utente: vigilo). Se vuota, Vigilo ne crea una al primo avvio
# e la salva in data/ui_password.
VIGILO_UI_PASSWORD=

# Regione dell'account Tesla al primo avvio: eu (Europa, Medio Oriente, Africa) o na (Nord America, Asia-Pacifico).
VIGILO_REGION=eu

# Broker MQTT esterno (facoltativo). Se vuoto, Vigilo usa un suo broker interno.
# Utile solo se hai Home Assistant in Docker (senza Supervisor) e vuoi le entità MQTT.
MQTT_HOST=
MQTT_PORT=
MQTT_USERNAME=
MQTT_PASSWORD=
